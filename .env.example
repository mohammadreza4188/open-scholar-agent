# Copy to .env and fill in. NEVER commit .env.
# All external services are optional: with no keys the app runs on mocks.

OSA_DATABASE_URL=sqlite:///data/open_scholar.db
OSA_LOG_LEVEL=INFO

# Telegram (empty -> MockTransport, messages are printed locally)
TELEGRAM_BOT_TOKEN=
# Optional comma-separated Telegram user ids allowed to use the bot (empty = anyone)
TELEGRAM_ALLOWED_USER_IDS=

# Search providers (empty -> mock search provider)
BRAVE_API_KEY=
TAVILY_API_KEY=

# LLM (all optional; without a key the app uses rule-based extraction)
# auto = first provider whose key is set | none = disable the LLM | openai|anthropic|gemini|openai_compatible
OSA_LLM_PROVIDER=auto
# Required for openai, gemini and openai_compatible (no default model is assumed).
# anthropic defaults to claude-haiku-5-5.
OSA_LLM_MODEL=
# Only for openai_compatible endpoints / proxies:
OSA_LLM_BASE_URL=
# Optional USD per million tokens, used only for cost estimates:
OSA_LLM_PRICE_IN_PER_MTOK=
OSA_LLM_PRICE_OUT_PER_MTOK=
# Max pages fetched/analysed per /run (bounds time and LLM cost):
OSA_MAX_PAGES_PER_RUN=5

# Provider API keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
